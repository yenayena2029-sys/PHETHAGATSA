# SnapShop Environment Variables Template
# Copy this file to .env and fill in the values

# Application URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Database Configuration (Required)
# E.g., mongodb+srv://username:password@cluster.mongodb.net/snapshop
MONGODB_URI=""

# Security (Required)
# Generate a secure random string for JWT token encryption
JWT_SECRET=""

# Payment Gateways (Optional - Can also be configured in Admin Panel)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Cloud Storage (Optional - Can also be configured in Admin Panel)
DO_SPACES_ENDPOINT=""
DO_SPACES_REGION=""
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_BUCKET=""

AWS_S3_REGION=""
AWS_S3_KEY=""
AWS_S3_SECRET=""
AWS_S3_BUCKET=""

GCS_BUCKET=""
GCS_KEY=""
GCS_SECRET=""

B2_ENDPOINT=""
B2_KEY_ID=""
B2_KEY=""
B2_BUCKET=""

# AI Translation Providers (Optional - Can also be configured in Admin Panel)
OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# MongoDB Model API (OpenAI-compatible, optional)
MONGODB_AI_ENDPOINT="https://ai.mongodb.com"
MONGODB_AI_API_KEY=""
